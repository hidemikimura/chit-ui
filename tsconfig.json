{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.js", "src/**/*.ts", "test/**/*.js"]
}
