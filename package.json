{
  "name": "@hidemikimura/chit-ui",
  "version": "0.3.2",
  "description": "Lit-based chat widget UI: launcher, panel, themable, any HTML or Lit component as a message",
  "license": "MIT",
  "homepage": "https://hidemikimura.github.io/chit-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hidemikimura/chit-ui.git"
  },
  "bugs": {
    "url": "https://github.com/hidemikimura/chit-ui/issues"
  },
  "author": "Hidemi Kimura",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./element.js": {
      "types": "./dist/types/element.d.ts",
      "default": "./src/element.js"
    },
    "./themes.js": {
      "types": "./dist/types/themes/index.d.ts",
      "default": "./src/themes/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/index.js",
    "./src/bundle.js"
  ],
  "keywords": [
    "chat",
    "chat-ui",
    "chat-widget",
    "lit",
    "web-components",
    "custom-elements"
  ],
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/mocha": "^10.0.9",
    "@web/dev-server": "^0.4.6",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-playwright": "^0.11.0",
    "lit": "^3.2.0",
    "playwright": "^1.48.0",
    "rollup": "^4.24.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "dev": "web-dev-server --node-resolve --open /demo/ --watch",
    "typecheck": "tsc --noEmit",
    "types": "tsc -p tsconfig.build.json && node scripts/finish-types.mjs",
    "bundle": "rollup -c && node scripts/check-size.js",
    "build": "npm run typecheck && npm run types && npm run bundle",
    "test": "web-test-runner \"test/**/*.test.js\" --node-resolve",
    "prepublishOnly": "npm run build && npm test",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "check": "npm run typecheck && npm test && npm run audit:a11y"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
